# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.4
#
# Optional ENV vars
# ------------------
#   MVNW_REPOURL - repo url base for downloading maven distribution
#   MVNW_USERNAME/MVNW_PASSWORD - user and password for downloading maven
#   MVNW_VERBOSE - true: enable verbose log; others: silence the output
# ----------------------------------------------------------------------------

set -euf
[ "${MVNW_VERBOSE-}" != true ] || set -x

# OS specific support.
native_path() { printf '%s\n' "$1"; }
case "$(uname)" in
CYGWIN* | MINGW*)
  [ -z "${SYSTEMROOT-}" ] || native_path() { cygpath --path --windows "$1"; }
  ;;
esac

if [ -z "${MAVEN_USER_HOME-}" ]; then
  MAVEN_USER_HOME="${HOME}/.m2"
fi

MAVEN_WRAPPER_SETTING_FILE=".mvn/wrapper/maven-wrapper.properties"

if [ -r "$MAVEN_WRAPPER_SETTING_FILE" ]; then
  eval "$(grep -E "^(distributionUrl|wrapperVersion|distributionSha256Sum)=" "$MAVEN_WRAPPER_SETTING_FILE")"
fi

if [ -z "${distributionUrl-}" ]; then
  echo "Cannot find distributionUrl in $MAVEN_WRAPPER_SETTING_FILE" >&2
  exit 1
fi

WRAPPER_LAUNCHER_JAR="$MAVEN_USER_HOME/wrapper/dists/$(basename "$distributionUrl" .zip)/bin/mvn"

exec "$WRAPPER_LAUNCHER_JAR" "$@"
